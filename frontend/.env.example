# Frontend configuration.
#
# In development the Vite proxy forwards /api to http://127.0.0.1:8000, so this
# can be left blank.
#
# For a deployed frontend (e.g. Vercel) pointing at a backend elsewhere, set the
# full origin of the API — including https:// and no trailing slash:
#   VITE_API_BASE_URL=https://your-backend-host
VITE_API_BASE_URL=
