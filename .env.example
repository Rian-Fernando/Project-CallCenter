# =============================================================================
# Village of Garden City — AI Receptionist (Proof of Concept)
# Copy to `.env` and edit as needed:   cp .env.example .env
# Every default below runs 100% locally at $0 cost.
# =============================================================================

APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-project.vercel.app

# -----------------------------------------------------------------------------
# LLM  —  provider is swappable: ollama | openai | anthropic | gemini
# Only `ollama` is implemented. The others raise a clear NotImplementedError
# that documents exactly what to add. See backend/app/providers/llm/.
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Qwen3 is a hybrid-reasoning model. Its <think> phase costs ~8x latency for no
# measurable quality gain on these tasks (benchmarked: 9.93s vs 1.29s).
# Leave false unless you are debugging model reasoning.
OLLAMA_THINKING=false
OLLAMA_TIMEOUT_SECONDS=90
# Keep the model loaded in RAM between turns. Ollama unloads after 5 minutes
# by default, and a cold reload costs ~5s on the next caller.
OLLAMA_KEEP_ALIVE=30m
LLM_TEMPERATURE=0.1
# Answers are spoken aloud, so they should be short. 220 tokens is roughly
# 4 sentences and keeps generation near 2 seconds.
LLM_MAX_TOKENS=220

# Optional smaller/faster model for intent classification. Leave blank to reuse
# OLLAMA_MODEL (recommended on 16GB machines — a 2nd model costs ~2GB more RAM).
# Good alternative if you want lower latency:  llama3.2:3b
OLLAMA_ROUTER_MODEL=

# Future paid providers — leave blank for the free prototype.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=


# -----------------------------------------------------------------------------
# Gemini (OPTIONAL — free tier, much faster than local inference)
#
#   Local qwen3:8b  ~2-3s to first token
#   Gemini Flash    ~0.3-0.6s to first token, and higher quality
#
# *** PRIVACY WARNING — READ BEFORE ENABLING FOR REAL RESIDENT DATA ***
#   On Google's UNPAID tier, your prompts and responses are used to improve
#   Google's products and MAY BE REVIEWED BY HUMANS. Every resident question
#   would become training data, and text leaves this machine.
#
#   Fine for: development, speed demos, test questions.
#   Not fine for: real resident calls unless the Village accepts it and has a
#   data processing agreement (that requires the PAID tier).
#
#   Free key: https://aistudio.google.com/apikey
#   To enable:  LLM_PROVIDER=gemini  and set GEMINI_API_KEY below.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# Embeddings (served by Ollama — no PyTorch required)
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# -----------------------------------------------------------------------------
# Vector database — Qdrant
#   Leave QDRANT_URL blank  -> embedded on-disk mode (no Docker, zero setup)
#   Set it to a server URL  -> client/server mode (docker/docker-compose.yml)
# -----------------------------------------------------------------------------
QDRANT_URL=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=garden_city_kb

# -----------------------------------------------------------------------------
# Database
#   SQLite default (zero setup). Switch to Postgres by changing this one line:
#   DATABASE_URL=postgresql+asyncpg://gc:gc@localhost:5432/gardencity
#   (then: pip install asyncpg  &&  docker compose up -d postgres)
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/gardencity.db

# -----------------------------------------------------------------------------
# Speech-to-Text — faster-whisper (local)
#   Models by size/accuracy: tiny.en < base.en < small.en < medium.en
#   base.en (~145MB) is the accuracy/latency sweet spot on Apple Silicon.
# -----------------------------------------------------------------------------
STT_PROVIDER=local_whisper
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1

# -----------------------------------------------------------------------------
# Text-to-Speech
#   kokoro    Natural-sounding local voice (Apache-2.0, 82M params). DEFAULT.
#             ~337MB downloads automatically on first use. Sounds markedly more
#             human than Piper; slightly slower per call but still ~0.3x
#             realtime, and sentence-level streaming hides the difference.
#   piper     Faster but noticeably robotic. Good on very low-spec machines.
#   macos_say macOS system voices (install natural ones in System Settings ->
#             Accessibility -> Spoken Content -> Manage Voices).
#   browser   Web Speech API — last-resort fallback, always works.
#
#   Kokoro voices: af_heart (warm female, default), af_bella, af_nicole,
#                  am_michael, am_adam, bf_emma
# -----------------------------------------------------------------------------
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_heart
KOKORO_MODEL_DIR=./data/models/kokoro
# 1.0 is natural. 0.9 sounds more deliberate; 1.1 more brisk.
KOKORO_SPEED=1.0
PIPER_VOICE=en_US-lessac-medium
PIPER_VOICE_DIR=./data/models/piper
TTS_FALLBACK_ENABLED=true

# -----------------------------------------------------------------------------
# RAG retrieval tuning
#   NOTE: chunk size/overlap are measured in TOKENS (not characters), because
#   the sentence splitter tokenizes. ~400 tokens is roughly 1,600 characters.
#   Smaller chunks retrieve more precisely for short FAQ-style questions;
#   larger chunks preserve more context. 400/80 tested well on this corpus.
# -----------------------------------------------------------------------------
RAG_TOP_K=6
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80
RAG_MIN_SCORE=0.35

# -----------------------------------------------------------------------------
# Confidence thresholds  (see config/confidence.yaml for signal weights)
#   >= HIGH   -> answer directly
#   >= MEDIUM -> ask a clarifying question
#   <  MEDIUM -> escalate to a human department
# -----------------------------------------------------------------------------
CONFIDENCE_HIGH=0.62
CONFIDENCE_MEDIUM=0.38
GROUNDING_CHECK_ENABLED=true

# -----------------------------------------------------------------------------
# Privacy / retention  (§17)
#   Conversations older than this are purged by the retention job.
#   0 = keep forever. Prototype default is deliberately short.
# -----------------------------------------------------------------------------
RETENTION_DAYS=7
STORE_AUDIO=false

# -----------------------------------------------------------------------------
# Village website crawler (§8)
#   Polite by design: obeys robots.txt, rate-limited, caches to disk.
# -----------------------------------------------------------------------------
VILLAGE_BASE_URL=https://www.gardencityny.net
VILLAGE_SITEMAP_URL=https://www.gardencityny.net/sitemap.xml
CRAWL_ENABLED=true
CRAWL_MAX_PAGES=150
CRAWL_DELAY_SECONDS=1.0
CRAWL_USER_AGENT=GardenCityAI-POC/0.1 (local municipal AI prototype)

# -----------------------------------------------------------------------------
# GoGov integration (§21) — mock | live
#   GoGov has no publicly documented API. `live` is intentionally unimplemented;
#   see docs/GOGOV_INTEGRATION.md for exactly what would be required.
# -----------------------------------------------------------------------------
GOGOV_MODE=mock
GOGOV_BASE_URL=
GOGOV_API_KEY=
